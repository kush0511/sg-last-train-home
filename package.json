{
  "name": "sg-last-train-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "data:export": "tsx scripts/export-data.ts",
    "data:import:smrt-timetables": "tsx scripts/import-smrt-timetables.ts",
    "data:import:sbs-timetables": "tsx scripts/import-sbs-timetables.ts",
    "data:import:operator-timetables": "npm run data:import:smrt-timetables && npm run data:import:sbs-timetables",
    "data:audit:timetable-coverage": "tsx scripts/audit-timetable-coverage.ts",
    "data:refresh:public-holidays": "tsx scripts/refresh-public-holidays.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:freshness": "tsx scripts/check-freshness.ts",
    "check": "npm run validate:data && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
